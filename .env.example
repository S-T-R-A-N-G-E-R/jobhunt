# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OLLAMA_HOST=http://localhost:11434
# Optional: only needed for the paid fallback / calibrate. Everything works without it.
ANTHROPIC_API_KEY=
# Optional: IANA timezone for "today" (default: this machine's timezone), e.g. Europe/Berlin
JOBHUNT_TIMEZONE=
# Optional: Ollama Cloud instead of a local server (see docs/CLOUD.md). Sent only over https.
OLLAMA_API_KEY=
# Optional: override llm.local.model / llm.local.think from profile.yaml (e.g. gpt-oss:20b / low)
JOBHUNT_LLM_MODEL=
JOBHUNT_LLM_THINK=
# Optional: score range for "Near misses" when the digest has fewer than 2 matches (default 55-69, or off)
JOBHUNT_NEAR_MISS=
# Optional: the private GitHub repo that runs jobhunt daily (docs/CLOUD.md), e.g. <you>/<private-runner-repo>
JOBHUNT_RUNNER_REPO=
